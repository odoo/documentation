msgstr "No hay necesidad de generar asientos en diciembre."

#: ../../export/content/applications/finance/accounting/customer_invoices/deferred_revenues.rst:173
#: ../../export/content/applications/finance/accounting/vendor_bills/deferred_expenses.rst:173
msgid "In total"
msgstr "En total"

#: ../../export/content/applications/finance/accounting/customer_invoices/deferred_revenues.rst:174
#: ../../export/content/applications/finance/accounting/vendor_bills/deferred_expenses.rst:174
msgid "If we aggregate everything, we would have:"
msgstr "Si sumamos todo, tendríamos:"

#: ../../export/content/applications/finance/accounting/customer_invoices/deferred_revenues.rst:176
