msgstr ":guilabel:`מספר זיהוי מס`: הזן את מספר הזיהוי עבור סוג הנישום שנבחר."

#: ../../export/content/applications/finance/fiscal_localizations/guatemala.rst:106
msgid ""
":guilabel:`VAT Affiliation`: Select the VAT affiliation for the company, "
"which is the type of Regime the company belongs to."
msgstr ""
