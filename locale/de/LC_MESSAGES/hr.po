#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:160
msgid ""
":guilabel:`Gross`: Net payable amount from |MPF| gross after consideration "
"of |MPF| deductions."
msgstr ""
":guilabel:`Gross`: Netto-Auszahlungsbetrag aus |MPF|-Brutto nach "
