#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:784
msgid ":ref:`Create vendor bills <accounting/vendor_bills/creation>`."
msgstr ":ref:`Luo toimittajalaskuja <accounting/vendor_bills/creation>`."

#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:785
msgid ""
":doc:`Pay the vendor bills <../accounting/payments>` using :guilabel:`U.S. "
"Direct Deposit` as the :guilabel:`Payment Method` for the transaction."
msgstr ""
":doc:`Maksa toimittajalaskut <../accounting/payments>` käyttämällä "
"maksutapana :guilabel:`U.S. Direct Deposit` tapahtumassa :guilabel:`Payment "
