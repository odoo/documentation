#: ../../export/content/applications/finance/accounting/customer_invoices/electronic_invoicing/turkiye.rst:5
msgid "Odoo electronic invoicing in Türkiye"
msgstr "Odoon sähköinen laskutus Turkissa"

#: ../../export/content/applications/finance/accounting/customer_invoices/electronic_invoicing/turkiye.rst:7
msgid ""
"Odoo Invoicing is your trusted partner for safe, efficient, and legally "
