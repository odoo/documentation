#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:116
msgid ""
"To set a :guilabel:`Default value`, select one of the available values."
msgstr "要設定:guilabel:`預設值`，請選擇其中一個可用值。"

#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:117
#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:189
#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:215
#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:237
