msgid ":guilabel:`Phone`: Enter the company phone number."
msgstr ":guilabel:`رقم الهاتف`: أدخل رقم هاتف الشركة."

#: ../../export/content/applications/hr/payroll/payroll_localizations/australia.rst:104
#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:71
#: ../../export/content/applications/hr/payroll/payroll_localizations/india.rst:64
#: ../../export/content/applications/hr/payroll/payroll_localizations/mexico.rst:87
#: ../../export/content/applications/hr/payroll/payroll_localizations/oman.rst:70
