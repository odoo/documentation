msgid ":doc:`../pipeline/manage_sales_teams`"
msgstr ":doc:`../pipeline/manage_sales_teams`"

#: ../../export/content/applications/sales/crm/acquire_leads/opportunities_form.rst:116
msgid ":doc:`convert`"
msgstr ":doc:`convert`"

#: ../../export/content/applications/sales/crm/acquire_leads/opportunities_form.rst:117
#: ../../export/content/applications/sales/crm/pipeline/manage_sales_teams.rst:144
msgid ":doc:`../track_leads/lead_scoring`"
msgstr ":doc:`../track_leads/lead_scoring`"

