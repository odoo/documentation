#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:177
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:180
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:183
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:186
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:189
msgid "Numeric identifier"
msgstr "Numeerinen tunniste"

#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:175
msgid "Package name"
msgstr "Pakkauksen nimi"

#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:177
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_usage.rst:40
#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_usage.rst:168
msgid "Global Trade Item Number (GTIN)"
