msgstr ":guilabel:`First Name`"

#: ../../content/applications/finance/fiscal_localizations/philippines.rst:227
msgid ":guilabel:`Middle Name`"
msgstr ":guilabel:`Middle Name`"

#: ../../content/applications/finance/fiscal_localizations/philippines.rst:228
