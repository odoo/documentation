#: ../../export/content/applications/productivity/ai/mcp_server.rst:151
msgid "ChatGPT"
msgstr "ChatGPT"

#: ../../export/content/applications/productivity/ai/mcp_server.rst:153
msgid ""
"Open ChatGPT, navigate to :menuselection:`Settings --> Plugins --> Add / Add "
