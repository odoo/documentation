msgid ":guilabel:`Incoming`: Inbound moves entering inventory."
msgstr ":guilabel:`Saapuvat`: Saapuvat siirrot, jotka tulevat varastoon."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:48
msgid ":guilabel:`Outgoing`: Outbound moves leaving inventory."
msgstr ":guilabel:`Lähtevät`: Lähtevät siirrot, jotka poistuvat varastosta."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:49
msgid ""
":guilabel:`Inventory`: Internal move records, such as inventory adjustments."
msgstr ""
":guilabel:`Inventointi`: Sisäiset siirtotietueet, kuten varaston oikaisut."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:50
msgid ""
":guilabel:`Remaining`: Moves that still have a remaining quantity in stock."
msgstr ""
":guilabel:`Jäljellä`: Siirrot, joiden määrää on vielä jäljellä varastossa."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:51
