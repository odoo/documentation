#: ../../export/content/applications/productivity/sign.rst:41
msgid ""
"define :ref:`advanced configuration for signers <sign/request-"
"signatures/signer-settings>` to require authentication (via SMS, Aadhaar "
"eSign, or itsme®), allow delegation, or, for templates, assign a fixed "
"signer"
msgstr ""
