msgid ""
":doc:`Subscribe to Newsletter </applications/marketing/email_marketing/"
"mailing_lists>`"
msgstr ""
":doc:`Tilmeld nyhedsbrev </applications/marketing/email_marketing/"
"mailing_lists>`"

