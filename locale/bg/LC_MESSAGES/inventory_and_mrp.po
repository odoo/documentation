msgstr ""
"Odoo избира правило за прибиране въз основа на следния списък с приоритети "
"(от най-висок към най-нисък), докато не бъде намерено съвпадение:"

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/daily_operations/putaway.rst:94
msgid "Package type and product"
msgstr "Тип опаковка и продукт"

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/daily_operations/putaway.rst:95
msgid "Package type and product category"
msgstr "Тип опаковка и категория продукт"

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/daily_operations/putaway.rst:98
msgid "Product category"
msgstr "Категория продукт"

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/daily_operations/putaway.rst:101
