#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:157
msgid ""
":guilabel:`Employer Voluntary Contribution`: Voluntary employer contribution "
"(if any)."
msgstr ""
":guilabel:`Freiwilliger Arbeitgeberbeitrag`: Freiwilliger Arbeitgeberbeitrag "
