msgstr "*--*"

#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:367
msgid "Net Other Income"
msgstr "הכנסה אחרת נטו"

#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:369
