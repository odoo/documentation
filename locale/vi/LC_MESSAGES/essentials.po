msgstr ":ref:`Văn bản <studio/fields/simple-fields-text>`"

#: ../../export/content/applications/essentials/property_fields.rst:39
msgid "Short text on a single line"
msgstr "Văn bản ngắn trên một dòng"

#: ../../export/content/applications/essentials/property_fields.rst:40
#: ../../export/content/applications/essentials/property_fields.rst:43
#: ../../export/content/applications/essentials/property_fields.rst:46
