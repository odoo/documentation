msgstr ":guilabel:`Saksa - Kassajärjestelmän sertifiointi`"

#: ../../export/content/applications/finance/fiscal_localizations/germany.rst:27
msgid "`l10n_de_pos_cert`"
msgstr "`l10n_de_pos_cert`"

#: ../../export/content/applications/finance/fiscal_localizations/germany.rst:28
msgid ""
"Includes the implementation of the Technical Security System, using a cloud-"
