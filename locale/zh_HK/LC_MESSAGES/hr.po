#: ../../export/content/applications/hr/time_off/management.rst:105
msgid ""
"*Duration Selector*: Click the corresponding button to indicate if the "
"request is for a :guilabel:`Full Day`, the :guilabel:`Morning`, or the "
":guilabel:`Afternoon`."
msgstr ""

#: ../../export/content/applications/hr/time_off/management.rst:107
