#: ../../export/content/applications/productivity/sign/sign_document.rst:224
msgid "Enable the Sign option in Documents"
msgstr ""

#: ../../export/content/applications/productivity/sign/sign_document.rst:226
msgid ""
"Enabling the :guilabel:`Sign` option for a :ref:`folder or sub-folder in the"
