msgstr ""
"Конфигурирайте продукти, категории, комбинации и показвания на сериен номер."

#: ../../export/content/applications/sales/point_of_sale.rst:28
#: ../../export/content/applications/sales/point_of_sale/hardware_network.rst:5
msgid "Hardware and network"
msgstr "Хардуер и мрежа"

#: ../../export/content/applications/sales/point_of_sale.rst:28
