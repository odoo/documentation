msgid "Example barcode label with the product name cut off."
msgstr "Esempio di etichetta codice a barre con il nome del prodotto tagliato."

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/zebra.rst:108
#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/zebra.rst:123
#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/setup_configuration/zebra.rst:156
