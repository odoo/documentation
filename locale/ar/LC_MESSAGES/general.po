#: ../../export/content/applications/general/iot/iot_advanced/troubleshooting.rst:33
msgid "The IoT system is connected to the Odoo database but cannot be reached"
msgstr "نظام إنترنت الأشياء متصل بقاعدة بيانات Odoo لكن لا يمكن الوصول إليه"

#: ../../export/content/applications/general/iot/iot_advanced/troubleshooting.rst:35
msgid ""
