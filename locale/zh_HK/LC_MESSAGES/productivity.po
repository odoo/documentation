#: ../../export/content/applications/productivity/calendar/outlook.rst:227
msgid "Reset options"
msgstr ""

#: ../../export/content/applications/productivity/calendar/google.rst:197
msgid ""
"The following reset options are available for troubleshooting Google "
"calendar sync with Odoo:"
msgstr ""

#: ../../export/content/applications/productivity/calendar/google.rst:199
msgid "Google calendar reset options in Odoo."
msgstr "Odoo 中的 Google 日曆重設選項。"

#: ../../export/content/applications/productivity/calendar/google.rst:202
#: ../../export/content/applications/productivity/calendar/outlook.rst:236
