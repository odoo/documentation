msgid "Contact configurations"
msgstr "聯絡人設定"

#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:951
msgid "Taxpayer Type needed for the Electronic Exports of Goods module."
msgstr "電子貨物出口模組所需的納稅人類型。"

#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:955
msgid "Chilean customs"
msgstr "智利海關"

#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:957
msgid ""
"When creating an electronic exports of goods invoice, these new fields in "
