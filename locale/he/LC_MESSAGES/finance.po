#: ../../export/content/applications/finance/accounting/reporting/year_end.rst:293
msgid ""
":guilabel:`Aged payables per partner`: Review payables without a partner."
msgstr ":guilabel:`חייבים מיושנים לפי שותף`: סקור חייבים ללא שותף."

#: ../../export/content/applications/finance/accounting/reporting/year_end.rst:294
msgid ""
":guilabel:`Aged receivables per partner`: Review receivables without a "
"partner."
msgstr ":guilabel:`חובות מיושנות לפי שותף`: סקור חובות ללא שותף."

#: ../../export/content/applications/finance/accounting/reporting/year_end.rst:295
msgid ""
":guilabel:`Bank Reconciliation`: Reconcile all bank account transactions up "
"to year-end."
msgstr ":guilabel:`התאמת בנק`: התאם את כל עסקאות חשבון הבנק עד סוף השנה."

#: ../../export/content/applications/finance/accounting/reporting/year_end.rst:296
msgid ""
":guilabel:`Deferred Entries`: Ensure start and end dates are correctly set "
"on bills and invoices."
msgstr ""
":guilabel:`רשומות דחויות`: ודא שתאריכי התחלה וסיום מוגדרים נכון בחשבוניות "
