#: ../../export/content/applications/finance/accounting/customer_invoices/sequence.rst:55
#: ../../export/content/applications/finance/accounting/vendor_bills/sequence.rst:55
msgid "In the :guilabel:`Ordering` field, choose to"
msgstr ":guilabel:`Järjestys` -kentässä valitse"

#: ../../export/content/applications/finance/accounting/customer_invoices/sequence.rst:57
#: ../../export/content/applications/finance/accounting/vendor_bills/sequence.rst:57
msgid ""
":guilabel:`Keep current order`: The order of the numbers remains the same."
msgstr ""
":guilabel:`Säilytä nykyinen järjestys`: Numeroiden järjestys pysyy samana."

#: ../../export/content/applications/finance/accounting/customer_invoices/sequence.rst:58
