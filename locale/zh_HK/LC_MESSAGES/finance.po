#: ../../export/content/applications/finance/fiscal_localizations/poland.rst:101
msgid ""
"Fill in the :guilabel:`Company Name`, :guilabel:`VAT` (Tax ID), and "
":guilabel:`Country`. If desired, fill in additional optional fields such as "
":guilabel:`Street`, :guilabel:`City`, :guilabel:`State`, and "
":guilabel:`ZIP`."
msgstr ""
