msgstr "テンプレートの作成"

#: ../../export/content/applications/productivity/sign/request_signatures.rst:103
#: ../../export/content/applications/productivity/spreadsheet/get_started.rst:53
msgid "To create a template:"
msgstr "テンプレートを作成するには:"

#: ../../export/content/applications/productivity/sign/request_signatures.rst:105
#: ../../export/content/applications/productivity/sign/request_signatures.rst:204
#: ../../export/content/applications/productivity/sign/request_signatures.rst:218
msgid "Go to :menuselection:`Sign --> Templates`."
msgstr ":menuselection:`署名 --> テンプレート`\\ に移動します。"

#: ../../export/content/applications/productivity/sign/request_signatures.rst:106
