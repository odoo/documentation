"Price or cost of the product, depending on whether it is bought, sold, or "
"used as a component"
msgstr ""
"Giá hoặc chi phí của sản phẩm, tùy thuộc vào việc sản phẩm được mua, bán hay "
"sử dụng làm linh kiện"

#: ../../export/content/applications/essentials/product_catalog.rst:61
msgid "Reference code (e.g. *DESK0005*)"
msgstr "Mã tham chiếu (ví dụ: *DESK0005*)"

#: ../../export/content/applications/essentials/product_catalog.rst:62
msgid "Available quantity"
msgstr "Số lượng hiện có"

#: ../../export/content/applications/essentials/product_catalog.rst:63
msgid "On-hand quantity"
msgstr "Số lượng tồn kho"

#: ../../export/content/applications/essentials/product_catalog.rst:64
msgid "Variant attributes (e.g., colors, materials, customizations, etc.)"
msgstr "Thuộc tính biến thể (ví dụ: màu sắc, chất liệu, tùy chỉnh,...)"

#: ../../export/content/applications/essentials/product_catalog.rst:65
msgid ""
":icon:`fa-shopping-cart` :guilabel:`Add` button (if relevant to the current "
