msgstr "Klikkaa :icon:`fa-cog` :guilabel:`(hammasratas)` -kuvaketta"

#: ../../export/content/applications/finance/fiscal_localizations/malaysia.rst:480
msgid "Select :guilabel:`Download`"
msgstr "Valitse :guilabel:`Lataa`"

#: ../../export/content/applications/finance/fiscal_localizations/malaysia.rst:481
msgid "Choose either :guilabel:`PDF` or :guilabel:`PDF without Payment`"
msgstr "Valitse joko :guilabel:`PDF` tai :guilabel:`PDF ilman maksua`"

