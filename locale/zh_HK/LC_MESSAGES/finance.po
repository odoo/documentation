#: ../../export/content/applications/finance/fiscal_localizations/south_korea.rst:270
msgid ":guilabel:`State`: The province or metropolitan city (-do)."
msgstr ":guilabel:`州/省`：省或廣域市（-do）。"

#: ../../export/content/applications/finance/fiscal_localizations/south_korea.rst:271
msgid ""
":guilabel:`City`: The city, county, or district (-si, -gun, -gu), followed "
