#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:1665
msgid "End of Year Bonus Payslips."
msgstr "Розрахункові листки бонусів наприкінці року."

#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:1671
