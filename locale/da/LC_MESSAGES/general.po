msgid ":ref:`Activate the developer mode. <developer-mode>`"
msgstr ":ref:`Aktiver udviklertilstand. <developer-mode>`"

#: ../../export/content/applications/general/users/ldap.rst:39
msgid ""
"Go to :menuselection:`Settings --> Technical --> System Parameters` and "
"click :guilabel:`New`."
msgstr ""
"Gå til :menuselection:`Indstillinger --> Teknisk --> Systemparametre` og "
"klik på :guilabel:`Ny`."

#: ../../export/content/applications/general/users/ldap.rst:41
msgid "Fill in the fields:"
msgstr "Udfyld felterne:"

