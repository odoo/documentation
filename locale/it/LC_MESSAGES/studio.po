#: ../../export/content/applications/studio/fields.rst:105
msgid "Examples of Multiline Text fields with different widgets"
msgstr "Esempi di campi Testo multiriga con vari widget"

#: ../../export/content/applications/studio/fields.rst:111
msgid "Integer (`integer`)"
msgstr "Intero (`integer`)"

#: ../../export/content/applications/studio/fields.rst:113
msgid ""
"The :guilabel:`Integer` field is used for all integer numbers "
