#: ../../export/content/applications/finance/fiscal_localizations/uruguay.rst:239
msgid ":guilabel:`Identification Number`:"
msgstr ":guilabel:`Número de identificación`:"

#: ../../export/content/applications/finance/fiscal_localizations/guatemala.rst:197
