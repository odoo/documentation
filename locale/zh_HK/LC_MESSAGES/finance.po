msgstr ":guilabel:`數量`"

#: ../../export/content/applications/finance/accounting/customer_invoices.rst:149
msgid ":guilabel:`Price`"
msgstr ""

#: ../../export/content/applications/finance/accounting/customer_invoices.rst:150
