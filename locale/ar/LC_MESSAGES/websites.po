msgstr ""

#: ../../content/applications/websites/ecommerce/cart.rst:74
msgid ""
":guilabel:`Action`: choose if the button should :guilabel:`Add to Cart` "
"or :guilabel:`Buy Now` (instant checkout)."
msgstr ""

#: ../../content/applications/websites/ecommerce/cart.rst:84
msgid "'Buy Now' button"
msgstr ""

#: ../../content/applications/websites/ecommerce/cart.rst:86
msgid ""
