msgstr ""

#: ../../export/content/applications/finance/fiscal_localizations/argentina.rst:350
msgid ""
"The electronic invoice and other |ARCA| services use the :guilabel:`Web "
"Services (WS)` provided by |ARCA|."
msgstr "電子發票及其他 |ARCA| 服務使用 :guilabel:`網絡服務（WS）`，由 |ARCA| 提供。"

