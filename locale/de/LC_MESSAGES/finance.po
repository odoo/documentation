#: ../../content/applications/finance/accounting/customer_invoices/electronic_invoicing.rst:157
msgid ""
"To send the invoice to the customer via Peppol, click :guilabel:`Send` on "
"the confirmed invoice form. In the :guilabel:`Send` window, enable "
"the :guilabel:`by Peppol` option and click :guilabel:`Send`."
msgstr ""
