#: ../../export/content/applications/finance/fiscal_localizations/philippines.rst:67
msgid ":guilabel:`Sales and Purchase VAT Exempt`: Exempt"
msgstr ":guilabel:`Myyntien ja ostojen veroton ALV`: Veroton"

#: ../../export/content/applications/finance/fiscal_localizations/philippines.rst:68
msgid ""
":guilabel:`Withholding Tax`: Expanded Withholding Tax (EWHT), Final "
"Withholding Tax (FWHT), and Withholding VAT (WVAT)."
