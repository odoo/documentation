#: ../../export/content/applications/hr/payroll/salary_rules.rst:174
msgid ":guilabel:`total`: rule total"
msgstr ":guilabel:`total`: total de la regla"

#: ../../export/content/applications/hr/payroll/salary_rules.rst:101
#: ../../export/content/applications/hr/payroll/salary_rules.rst:175
msgid ":guilabel:`amount`: rule amount"
msgstr ":guilabel:`amount`: importe de la regla"

#: ../../export/content/applications/hr/payroll/salary_rules.rst:102
#: ../../export/content/applications/hr/payroll/salary_rules.rst:176
