#: ../../export/content/applications/finance/accounting/reporting/intrastat.rst:49
msgid "Region code"
msgstr "地區代碼"

#: ../../export/content/applications/finance/accounting/reporting/intrastat.rst:51
msgid ""
"The region code is **only used by Belgian companies**. Under "
":menuselection:`Accounting --> Configuration --> Settings`, select the "
":guilabel:`Company Intrastat Region` where the company is located and then "
":guilabel:`Save`."
msgstr ""
