msgid ""
"1~\\text{day} * 8 &= 8~\\text{days} \\\\\n"
"3~\\text{days} + 3~\\text{days} + 3~\\text{days} &= 9~\\text{days} \\\\\n"
"1~\\text{week} + 1~\\text{week} &= 14~\\text{days} \\\\\n"
"\\\\\n"
"100 * 8 &= $800 \\\\\n"
"250 + 250 + 250 &= $750 \\\\\n"
"500 + 500 &= $1000\n"
"\n"
msgstr ""
"1~\\text{dag} * 8 &= 8~\\text{dagen} \\\\\n"
"3~\\text{dagen} + 3~\\text{dagen} + 3~\\text{dagen} &= 9~\\text{dagen} \\\\\n"
"1~\\text{week} + 1~\\text{week} &= 14~\\text{dagen} \\\\\n"
"\\\\\n"
"100 * 8 &= $800 \\\\\n"
"250 + 250 + 250 &= $750 \\\\\n"
"500 + 500 &= $1000\n"
"\n"

#: ../../export/content/applications/sales/rental.rst:96
msgid "Therefore, the customer pays $750 for the eight-day rental period."
msgstr "Daarom betaalt de klant $750 voor de huurperiode van acht dagen."

