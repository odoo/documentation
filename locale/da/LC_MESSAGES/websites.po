#: ../../export/content/applications/websites/ecommerce/payments.rst:3
msgid "Payments"
msgstr "Betalinger"

#: ../../export/content/applications/websites/ecommerce/payments.rst:5
msgid "E-commerce orders can be paid:"
msgstr "E-handelsordrer kan betales:"

#: ../../export/content/applications/websites/ecommerce/payments.rst:7
msgid ""
"via a payment method made available through a :ref:`supported payment "
"provider <payment_providers/supported_providers>`, such as debit and credit "
"cards;"
msgstr ""
"via en betalingsmetode stillet til rådighed gennem en :ref:`understøttet "
"betalingsudbyder <payment_providers/supported_providers>`, såsom debet- og "
"kreditkort;"

#: ../../export/content/applications/websites/ecommerce/payments.rst:9
msgid ""
"via a :doc:`bank payment </applications/finance/payment_providers/"
"bank_payments>`;"
msgstr ""
"via en :doc:`bankbetaling </applications/finance/payment_providers/"
"bank_payments>`;"

#: ../../export/content/applications/websites/ecommerce/payments.rst:10
msgid ""
"in person, either :ref:`on site <ecommerce/payments/pay-on-site>` "
"or :ref:`upon delivery <ecommerce/payments/cash-on-delivery>`;"
msgstr ""
"personligt, enten :ref:`på stedet <ecommerce/payments/pay-on-site>` "
"eller :ref:`ved levering <ecommerce/payments/cash-on-delivery>`;"

#: ../../export/content/applications/websites/ecommerce/payments.rst:12
msgid ""
"later, :ref:`after receiving an invoice <ecommerce/payments/pay-on-invoice>`."
msgstr ""
