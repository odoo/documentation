#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:745
msgid "Click the Bank accounts field, then select or create the bank."
msgstr "לחצו על שדה חשבונות הבנק, ולאחר מכן בחרו או צרו את הבנק."

#: ../../export/content/applications/finance/fiscal_localizations/united_states.rst:748
