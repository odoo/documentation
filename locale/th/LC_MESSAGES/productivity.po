msgstr ""
"จำนวนบันทึกทั้งหมดในโมเดลจะแสดงอยู่ด้านล่าง :guilabel:`โมเดล` ใน :ref:`คุณสมบัติรายการ "
"<spreadsheet/insert-list/properties>`."

#: ../../export/content/applications/productivity/spreadsheet/insert/insert_list.rst:436
msgid ""
"To modify the number of rows/records displayed, double-click the top-left "
