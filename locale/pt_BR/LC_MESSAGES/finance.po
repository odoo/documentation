msgid ""
"`Official Statement <http://bofip.impots.gouv.fr/bofip/10691-PGP.html?"
"identifiant=BOI-TVA-DECLA-30-10-30-20160803>`_"
msgstr ""
"`Declaração Oficial <http://bofip.impots.gouv.fr/bofip/10691-PGP.html?"
"identifiant=BOI-TVA-DECLA-30-10-30-20160803>`_"

#: ../../content/applications/finance/fiscal_localizations/france.rst:967
