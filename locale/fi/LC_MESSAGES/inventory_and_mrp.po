#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:39
msgid ":icon:`fa-filter` Filters"
msgstr ":icon:`fa-filter` Suodattimet"

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:41
