#: ../../export/content/applications/productivity/spreadsheet/share_collaborate.rst:9
msgid ""
":ref:`version history <spreadsheet/get-started/manage-spreadsheets-"
"versioning>`"
msgstr ""
":ref:`историю версий <spreadsheet/get-started/manage-spreadsheets-"
