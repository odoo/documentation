msgstr ":guilabel:`Código de Barras Móvel`"

#: ../../content/applications/finance/fiscal_localizations/taiwan.rst:309
msgid ":guilabel:`EasyCard`"
msgstr ":guilabel:`EasyCard`"

#: ../../content/applications/finance/fiscal_localizations/taiwan.rst:310
msgid ":guilabel:`iPass`"
msgstr ":guilabel:`iPass`"

#: ../../content/applications/finance/fiscal_localizations/taiwan.rst:313
msgid ""
"If no option has been selected, a :guilabel:`Print Ecpay invoice` can still "
"be downloaded from the invoice view."
msgstr ""
