msgid ""
":ref:`Odoo's default GS1 rules <barcode/operations/default-gs1-nomenclature-"
"list>`"
msgstr ""
":ref:`Odoo's standaard GS1 regels <barcode/operations/default-gs1-"
"nomenclature-list>`"

#: ../../export/content/applications/inventory_and_mrp/barcode/operations/gs1_nomenclature.rst:27
msgid ""
