msgstr "Настройте следующую информацию:"

#: ../../content/applications/finance/fiscal_localizations/colombia.rst:89
msgid ":guilabel:`Company Name`."
msgstr ":guilabel:`Название компании`."

#: ../../content/applications/finance/fiscal_localizations/colombia.rst:90
msgid ""
":guilabel:`Address`: Including :guilabel:`City`, :guilabel:`Department`, "
"and :guilabel:`ZIP` code."
msgstr ""
":guilabel:`Адрес`: включая :guilabel:`Город`, :guilabel:`Отдел` и почтовый "
