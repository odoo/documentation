msgstr ""
"Tuotteiden, luokkien, yhdistelmien ja sarjanumeroiden näyttöjen määritys."

#: ../../export/content/applications/sales/point_of_sale.rst:28
#: ../../export/content/applications/sales/point_of_sale/hardware_network.rst:5
msgid "Hardware and network"
msgstr "Laitteisto ja verkko"

#: ../../export/content/applications/sales/point_of_sale.rst:28
msgid "Connect and configure hardware peripherals and network settings."
msgstr "Laiteoheislaitteiden ja verkkoasetusten liittäminen ja määritys."

#: ../../export/content/applications/sales/point_of_sale.rst:33
#: ../../export/content/applications/sales/point_of_sale/shop.rst:5
msgid "Shop features"
msgstr "Verkkokaupan ominaisuudet"

#: ../../export/content/applications/sales/point_of_sale.rst:33
msgid ""
"Features specific to retail: manage quotations, \"ship later\" orders, and "
"barcodes."
msgstr ""
"Vähittäiskauppaan liittyvät ominaisuudet: tarjousten, \"toimita myöhemmin\" "
"-tilausten ja viivakoodien hallinta."

#: ../../export/content/applications/sales/point_of_sale.rst:38
#: ../../export/content/applications/sales/point_of_sale/restaurant.rst:5
msgid "Restaurant features"
msgstr "Ravintolan ominaisuudet"

#: ../../export/content/applications/sales/point_of_sale.rst:38
msgid ""
"Features specific to restaurants: manage floors, tables, tips, and online "
"delivery."
msgstr ""
"Ravintoloille ominaiset toiminnot: hallitse kerroksia, pöytiä, juomarahoja "
"ja verkkojakoa."

#: ../../export/content/applications/sales/point_of_sale.rst:43
#: ../../export/content/applications/sales/point_of_sale/extra.rst:5
msgid "Extra features"
msgstr "Lisäominaisuudet"

#: ../../export/content/applications/sales/point_of_sale.rst:43
msgid ""
"Shared features: manage employees, preparation displays, self-ordering, and "
"loyalty programs."
msgstr ""
"Yhteiset toiminnot: hallitse työntekijöitä, valmistusnäyttöjä, "
"itsepalvelutilaamista ja kanta-asiakasohjelmia."

#: ../../export/content/applications/sales/point_of_sale.rst:48
#: ../../export/content/applications/sales/point_of_sale/payment_methods.rst:5
msgid "Payment methods"
msgstr "Maksutavat"

#: ../../export/content/applications/sales/point_of_sale.rst:48
msgid ""
"Configure cash and card payments, cash machines, customer accounts, QR "
"codes, and payment terminals."
msgstr ""
"Määritä käteismaksut ja korttimaksut, kassakoneet, asiakastilit, QR-koodit "
"ja maksuterminaalit."

#: ../../export/content/applications/sales/point_of_sale.rst:54
#: ../../export/content/applications/sales/point_of_sale/reporting.rst:3
