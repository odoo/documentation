#: ../../content/applications/finance/fiscal_localizations/india.rst:397
msgid "E-waybill creation from receipts and delivery orders"
msgstr "Skapa e-waybill från inleveranser och leveransorder"

#: ../../content/applications/finance/fiscal_localizations/india.rst:400
