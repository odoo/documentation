msgstr ":guilabel:`Ist M1 oder L?`"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:849
msgid ":guilabel:`Special Authorization Issuing Entity`"
msgstr ":guilabel:`Sondergenehmigung ausstellende Stelle`"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:850
