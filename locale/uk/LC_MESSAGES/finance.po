#: ../../content/applications/finance/fiscal_localizations/vietnam.rst:103
msgid ":guilabel:`How to download file`: HSM"
msgstr ":guilabel:`Як завантажити файл`: HSM"

#: ../../content/applications/finance/fiscal_localizations/vietnam.rst:104
