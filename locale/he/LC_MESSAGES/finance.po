#: ../../export/content/applications/finance/payment_providers/adyen.rst:468
#: ../../export/content/applications/finance/payment_providers/adyen.rst:474
#: ../../export/content/applications/finance/payment_providers/bank_payments.rst:55
#: ../../export/content/applications/finance/payment_providers/buckaroo.rst:166
