msgstr ""
"Нажмите :guilabel:`Apps & Credentials` и нажмите :guilabel:`Create App`."

#: ../../content/applications/finance/payment_providers/paypal.rst:20
msgid "Enter an :guilabel:`App Name` and click :guilabel:`Create App`."
msgstr "Введите :guilabel:`App Name` и нажмите :guilabel:`Create App`."

