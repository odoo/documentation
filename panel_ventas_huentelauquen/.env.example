# Panel de Control de Ventas — Hacienda Huentelauquén
# Copie este archivo como .env y complete los datos de su Odoo.
# El .env contiene credenciales: no lo suba al repositorio.

# --- Conexión a Odoo (obligatorio) ------------------------------------------
ODOO_URL=https://huentelauquen.odoo.com
ODOO_DB=huentelauquen
ODOO_USERNAME=panel.ventas@huentelauquen.cl
# Use una CLAVE DE API de Odoo (Preferencias > Seguridad de la cuenta > Claves de API),
# no la contraseña del usuario.
ODOO_PASSWORD=

# --- Negocio (opcional) ------------------------------------------------------
# Compañía a la que se limita el panel. Vacío = todas las que vea el usuario.
PANEL_COMPANY_ID=
# Zona horaria con la que se recortan los meses. Odoo guarda en UTC.
PANEL_TIMEZONE=America/Santiago
PANEL_CURRENCY=CLP
# Estados de venta que cuentan como venta confirmada (presupuestos y
# cancelados quedan siempre fuera).
PANEL_SALE_STATES=sale,done
PANEL_ORG=Hacienda Huentelauquén

# --- Servidor (opcional) -----------------------------------------------------
PANEL_HOST=127.0.0.1
PANEL_PORT=8069
# Segundos que se reutiliza una consulta ya hecha. 0 desactiva la caché.
PANEL_CACHE_TTL=300
PANEL_REQUEST_TIMEOUT=30
