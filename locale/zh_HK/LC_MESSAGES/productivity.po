msgstr "必填、選填及唯讀欄位的範例"

#: ../../export/content/applications/productivity/sign/sign_document.rst:36
msgid "To sign a document prepared using Odoo Sign:"
msgstr ""

#: ../../export/content/applications/productivity/sign/sign_document.rst:38
