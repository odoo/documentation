#: ../../export/content/applications/studio/automated_actions.rst:545
msgid "Send WhatsApp"
msgstr "إرسال"

#: ../../export/content/applications/studio/automated_actions.rst:548
msgid ""
"To automate the sending of WhatsApp messages, one or more :ref:`WhatsApp "
