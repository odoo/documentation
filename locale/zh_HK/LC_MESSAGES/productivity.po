msgid ""
":ref:`add or remove dimensions <spreadsheet/pivot-tables/dimensions-add-"
"remove>`"
msgstr ":ref:`新增或移除維度 <spreadsheet/pivot-tables/dimensions-add-remove>`"

#: ../../export/content/applications/productivity/spreadsheet/work_with_data/pivot_tables.rst:211
msgid ""
":ref:`rearrange dimensions <spreadsheet/pivot-tables/dimensions-rearrange>`"
msgstr ":ref:`重新排列維度 <spreadsheet/pivot-tables/dimensions-rearrange>`"

