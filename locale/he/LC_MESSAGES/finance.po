msgid "**FAS**: Free alongside ship"
msgstr "**FAS**: חופשי לצד הספינה"

#: ../../export/content/applications/finance/accounting/customer_invoices/incoterms.rst:18
msgid "**FOB**: Free on board"
msgstr "**FOB**: חופשי על הסיפון"

