msgstr ":guilabel:`payslip`: El objeto `hr.payslip`."

#: ../../export/content/applications/hr/payroll/salary_rules.rst:93
msgid ":guilabel:`employee`: The `hr.employee` object."
msgstr ":guilabel:`employee`: El objeto `hr.employee`."

#: ../../export/content/applications/hr/payroll/salary_rules.rst:94
msgid ":guilabel:`version`: The `hr.version` object."
msgstr ":guilabel:`version`: El objeto `hr.version`."

#: ../../export/content/applications/hr/payroll/salary_rules.rst:95
msgid ""
":guilabel:`result_rules`: A dictionary containing the rules amounts, "
