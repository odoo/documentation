msgid ""
"change the second value in brackets, i.e., the row count, to the desired "
"number; or"
msgstr ""
"เปลี่ยนค่าที่สองในวงเล็บเหลี่ยม กล่าวคือ จำนวนแถว ให้เป็นจำนวนที่ต้องการ หรือ"

#: ../../export/content/applications/productivity/spreadsheet/insert/insert_list.rst:439
msgid ""
"remove the row count value to display *all* records and allow the list to "
