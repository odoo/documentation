#: ../../export/content/applications/productivity/spreadsheet/work_with_data/functions.rst:798
#: ../../export/content/applications/productivity/spreadsheet/work_with_data/functions.rst:1070
#: ../../export/content/applications/productivity/spreadsheet/work_with_data/global_filters.rst:175
#: ../../export/content/applications/productivity/whatsapp.rst:635
msgid "Text"
msgstr "ข้อความ"

