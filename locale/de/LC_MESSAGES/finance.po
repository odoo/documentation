msgid "Company type operator configurations in the Contact form."
msgstr "Konfigurationen für Fahrer vom Typ Unternehmen im Kontaktformular."

#: ../../content/applications/finance/fiscal_localizations/peru.rst:841
msgid "Vehicles"
msgstr "Fahrzeuge"

#: ../../content/applications/finance/fiscal_localizations/peru.rst:843
