msgstr ":guilabel:`Fecha de inicio`"

#: ../../export/content/applications/finance/fiscal_localizations/france.rst:912
msgid ":guilabel:`End Date`"
msgstr ":guilabel:`Fecha de finalización`"

#: ../../export/content/applications/finance/fiscal_localizations/france.rst:913
msgid ""
":guilabel:`Test File`: Enable this option to test the FEC file generation."
msgstr ""
":guilabel:`Archivo de prueba`: Habilite esta opción para probar la creación "
