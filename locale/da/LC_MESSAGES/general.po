msgid "Choosing who in the organization receives digest emails"
msgstr "Valg af, hvem i organisationen der modtager sammendrag-e-mails"

#: ../../export/content/applications/general/companies/digest_emails.rst:19
msgid "Creating custom digest email templates"
msgstr "Oprettelse af brugerdefinerede sammendrag-e-mail-skabeloner"

#: ../../export/content/applications/general/companies/digest_emails.rst:20
msgid ""
"Adding additional :abbr:`KPIs (key performance indicators)` (*Studio* app "
