msgstr "Odoo polo"

#: ../../export/content/applications/sales/sales/products_prices/products/import.rst:184
msgid "Sleeves: Long, Size: S"
msgstr "Sleeves: Long, Size: S"

#: ../../export/content/applications/sales/sales/products_prices/products/import.rst:185
msgid "Sleeves: Long, Size: M"
msgstr "Sleeves: Long, Size: M"

