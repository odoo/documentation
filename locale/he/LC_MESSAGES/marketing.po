msgid "Lost leads reactivation email"
msgstr "דוא\"ל להפעלה מחדש של לידים אבודים"

#: ../../export/content/applications/marketing/email_marketing.rst:29
msgid "Target lost leads with Email Marketing."
msgstr "מיקוד בלידים אבודים באמצעות שיווק במייל."

#: ../../export/content/applications/marketing/email_marketing.rst:34
msgid "Analyze Metrics"
msgstr "ניתוח מדדים"

#: ../../export/content/applications/marketing/email_marketing.rst:34
