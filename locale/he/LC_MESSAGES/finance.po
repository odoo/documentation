msgid ""
":ref:`Navigate to the Wire Transfer payment provider <payment_providers/"
"supported_providers>`."
msgstr ""
":ref:`Navigate to the Wire Transfer payment provider <payment_providers/"
"supported_providers>`."

#: ../../export/content/applications/finance/payment_providers/bank_payments.rst:27
#: ../../export/content/applications/finance/payment_providers/bank_payments.rst:78
