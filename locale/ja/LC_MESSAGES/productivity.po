#: ../../export/content/applications/productivity/phone/support_calls.rst:109
msgid "Log out of a support queue"
msgstr "サポートキューからログアウト"

#: ../../export/content/applications/productivity/phone/support_calls.rst:111
msgid ""
"Once the agent's shift ends, or if they are taking a break, they can log out "
