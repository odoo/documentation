#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:528
msgid ":guilabel:`Address`: The physical location of the rental property."
msgstr ":guilabel:`Dirección`: la ubicación física del inmueble arrendado."

#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:530
msgid "The completed Rental Details section."
msgstr "Sección Detalles del alquiler completada."

#: ../../export/content/applications/hr/payroll/payroll_localizations/hong_kong.rst:534
