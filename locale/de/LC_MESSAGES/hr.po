msgid ""
":guilabel:`Working Schedule`: Based on the employee's assigned :ref:`working "
"schedule <employees/schedule>` (e.g., 40 hours per week)."
msgstr ""
":guilabel:`Arbeitsplan`: Basierend auf dem zugewiesenen :ref:`Arbeitsplan "
"<employees/schedule>` des Mitarbeiters (z. B. 40 Stunden pro Woche)."

#: ../../export/content/applications/hr/payroll/payroll_localizations/australia.rst:310
#: ../../export/content/applications/hr/payroll/payroll_localizations/jordan.rst:146
#: ../../export/content/applications/hr/payroll/payroll_localizations/saudi_arabia.rst:142
#: ../../export/content/applications/hr/payroll/payroll_localizations/turkey.rst:128
