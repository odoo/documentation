msgstr "חלוקת אנשי קשר לרשימות תפוצה ספציפיות."

#: ../../export/content/applications/marketing/email_marketing.rst:24
msgid "Manage unsubscriptions (Blacklist)"
msgstr "ניהול ביטולי הרשמה (רשימה שחורה)"

#: ../../export/content/applications/marketing/email_marketing.rst:24
msgid "Allow recipients to unsubscribe and blacklist from future mailings."
msgstr "אפשר לנמענים לבטל הרשמה ולהוסיף לרשימה שחורה מתפוצות עתידיות."

#: ../../export/content/applications/marketing/email_marketing.rst:29
