msgid "Fulfilled By Lazada (FBL)"
msgstr "Fulfilled By Lazada (FBL)"

#: ../../export/content/applications/sales/sales/lazada_connector/features.rst:32
msgid "Synchronize completed orders."
msgstr "Synkronisera slutförda beställningar."

#: ../../export/content/applications/sales/sales/lazada_connector/features.rst:32
msgid "Synchronize all confirmed and unshipped orders."
msgstr "Synkronisera alla bekräftade och oskickade beställningar."

#: ../../export/content/applications/sales/sales/lazada_connector/features.rst:35
msgid ""
"Managed by Lazada, and synchronized with a virtual location to track it in "
"Odoo."
msgstr ""
"Hanteras av Lazada och synkroniseras med en virtuell plats för att spåra den "
"i Odoo."

#: ../../export/content/applications/sales/sales/lazada_connector/features.rst:35
msgid "Managed in Odoo Inventory app, and synchronized with Lazada."
msgstr "Hanteras i Odoo Lager-appen och synkroniseras med Lazada."

#: ../../export/content/applications/sales/sales/lazada_connector/features.rst:40
msgid "Handled by Lazada."
