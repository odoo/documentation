msgstr ":guilabel:`קוד מסוף`"

#: ../../export/content/applications/finance/fiscal_localizations/uruguay.rst:194
msgid "Required information for electronic invoice."
msgstr "מידע נדרש לחשבונית אלקטרונית."

#: ../../export/content/applications/finance/fiscal_localizations/uruguay.rst:198
msgid ""
"This data can be obtained from the Uruware portal after configuring "
