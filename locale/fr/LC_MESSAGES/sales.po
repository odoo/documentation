#: ../../export/content/applications/sales/sales/lazada_connector/setup.rst:127
msgid "Configure the shop before go-live"
msgstr "Configurer la boutique avant la mise en ligne"

#: ../../export/content/applications/sales/sales/lazada_connector/setup.rst:129
msgid "Set up warehouses:"
msgstr "Configurer les entrepôts :"

#: ../../export/content/applications/sales/sales/lazada_connector/setup.rst:131
msgid ""
"Navigate to :menuselection:`Sales app --> Configuration --> Settings --> "
"Connectors --> Lazada --> Lazada Shops`."
msgstr ""
"Naviguer vers :menuselection:`app Ventes --> Configuration --> Paramètres --"
"> Connecteurs --> Lazada --> Boutiques Lazada`."

#: ../../export/content/applications/sales/sales/lazada_connector/setup.rst:133
msgid ""
"Select the Lazada shop and configure the :guilabel:`FBM Warehouse` field to "
"limit stock fetching to specific warehouses."
msgstr ""
