msgid ""
":ref:`add or manipulate dimensions <spreadsheet/pivot-tables/dimensions>`"
msgstr ""
":ref:`добавить или изменить измерения <spreadsheet/pivot-tables/dimensions>`"

#: ../../export/content/applications/productivity/spreadsheet/work_with_data/pivot_tables.rst:177
