#: ../../export/content/applications/sales/rental/rental_orders/create_rental_order.rst:90
msgid ""
":ref:`Select an existing document template <sign/request-signatures/template-"
"odoo-record>` or :ref:`upload a new one <sign/request-signatures/one-off-"
"record>`."
msgstr ""
":ref:`Vælg en eksisterende dokumentskabelon <sign/request-signatures/"
