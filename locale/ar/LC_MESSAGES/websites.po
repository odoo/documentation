msgstr ":ref:`إنشاء وردية <planning/create-shift>`"

#: ../../export/content/applications/websites/website/web_design/building_blocks/forms.rst:26
msgid ""
":doc:`Create a Task </applications/services/project/tasks/task_creation>`"
msgstr ":doc:`إنشاء مهمة </applications/services/project/tasks/task_creation>`"

