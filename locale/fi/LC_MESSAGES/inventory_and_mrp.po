msgstr ""
":guilabel:`Lähdepaikka`: Ryhmittele tietueet varastosiirron lähdepaikan "
"mukaan."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:67
msgid ""
":guilabel:`Destination Location`: Group records by the destination location "
"of the stock move."
msgstr ""
":guilabel:`Kohdepaikka`: Ryhmittele tietueet varastosiirron kohdepaikan "
"mukaan."

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/reporting/moves_analysis.rst:69
