#: ../../export/content/applications/sales/point_of_sale/use/pos_invoices.rst:115
msgid "Invoice retrieval"
msgstr "Verkoopfactuur ophalen"

#: ../../export/content/applications/sales/point_of_sale/use/pos_invoices.rst:117
msgid ""
"Retrieving invoices is useful for customer requests and accounting purposes, "
"for example. To view, download, reprint, or send past transactions, follow "
