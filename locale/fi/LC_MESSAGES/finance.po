#: ../../export/content/applications/finance/fiscal_localizations/uzbekistan.rst:113
msgid "Each account is assigned a tag."
msgstr "Jokaiselle tilille on määritetty tunniste."

#: ../../export/content/applications/finance/fiscal_localizations/uzbekistan.rst:114
msgid "Tags correspond to specific lines in the reports."
msgstr "Tunnisteet vastaavat tiettyjä rivejä raporteissa."

#: ../../export/content/applications/finance/fiscal_localizations/uzbekistan.rst:115
msgid ""
