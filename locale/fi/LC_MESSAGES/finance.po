#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:304
msgid "Tax payments to the government."
msgstr "Veronmaksut valtiolle."

#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:305
msgid "Employees payments."
msgstr "Maksut työntekijöille."

