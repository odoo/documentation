#: ../../export/content/applications/marketing/marketing_card.rst:96
msgid ":guilabel:`Header`"
msgstr ":guilabel:`כותרת עליונה`"

#: ../../export/content/applications/marketing/marketing_card.rst:97
msgid ":guilabel:`Sub-Header`"
msgstr ":guilabel:`כותרת משנה`"

