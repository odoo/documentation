#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:668
msgid ":guilabel:`Partner or authorization number`"
msgstr ":guilabel:`Партнер або номер авторизації`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:669
msgid ":guilabel:`Date`"
msgstr ":guilabel:`Дата`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:670
msgid ":guilabel:`Document Type`"
msgstr ":guilabel:`Тип документа`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:671
msgid ":guilabel:`Document Number`"
msgstr ":guilabel:`Номер документа`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:672
msgid ":guilabel:`Tax Base`"
msgstr ":guilabel:`База оподаткування`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:673
msgid ":guilabel:`Tax`"
msgstr ":guilabel:`Податок`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:675
msgid ""
"Then, click :guilabel:`Confirm Vendor Bill` and :guilabel:`Process Now`. The "
