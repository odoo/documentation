msgid ":doc:`../reporting/tax_returns`"
msgstr ":doc:`../reporting/tax_returns`"

#: ../../export/content/applications/finance/accounting/get_started/journals.rst:262
#: ../../export/content/applications/finance/accounting/reporting/tax_returns.rst:15
