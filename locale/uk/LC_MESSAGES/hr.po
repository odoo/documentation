msgid ""
"\\text{Tax} = \\text{Gross Double Holiday} \\times \\text{Applicable Tax "
"Rate} -\n"
"\\text{Reduction (if applicable)}"
msgstr ""
"\\text{Податок} = \\text{Валова подвійна святкова} \\times \\text{Застосовна "
