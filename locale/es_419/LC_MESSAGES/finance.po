#: ../../export/content/applications/finance/fiscal_localizations/saudi_arabia.rst:422
msgid ":guilabel:`401 – Unauthorized`"
msgstr ":guilabel:`401 – Sin autorización`"

#: ../../export/content/applications/finance/fiscal_localizations/saudi_arabia.rst:423
