#: ../../export/content/applications/sales/point_of_sale/extra/presets.rst:139
msgid "Choose a time for a takeout order."
msgstr "Izberite čas za naročilo za s seboj."

#: ../../export/content/applications/sales/point_of_sale/extra/presets.rst:142
msgid ""
"If the :guilabel:`Guest` feature is enabled for the selected preset, a pop-"
"up appears prompting you to enter the number of guests, and the amount per "
"guest is displayed (the total amount divided by the number of guests)."
msgstr ""
"Če je funkcija :guilabel:`Gost` omogočena za izbrano prednastavitev, se "
"prikaže pojavno okno z zahtevo, da vnesete število gostov, prikazan pa je "
"tudi znesek na gosta (skupni znesek, deljen s številom gostov)."

#: ../../export/content/applications/sales/point_of_sale/extra/presets.rst:146
msgid "Enter the number of guests in the POS register."
msgstr "Vnesite število gostov v blagajno POS."

