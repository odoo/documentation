msgid ":guilabel:`Payment Method`: :guilabel:`ABA Credit Transfer`"
msgstr ":guilabel:`Спосіб оплати`: :guilabel:`ABA Credit Transfer`"

#: ../../content/applications/finance/fiscal_localizations/australia.rst:475
msgid ":guilabel:`Recipient Bank Account`: the vendor's account number"
msgstr ""
