#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:296
msgid "Cashier 1."
msgstr "Kassa 1."

#: ../../export/content/applications/finance/fiscal_localizations/chile.rst:297
msgid "Cashier 2."
