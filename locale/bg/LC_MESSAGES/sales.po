msgid "**Asia**"
msgstr "**Азия**"

#: ../../content/applications/sales/sales/tiktok_connector/features.rst:52
msgid "seller-id.tiktok.com"
msgstr "seller-id.tiktok.com"

#: ../../content/applications/sales/sales/tiktok_connector/features.rst:54
msgid "Japan"
msgstr "Япония"

