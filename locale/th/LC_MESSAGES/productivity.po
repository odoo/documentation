msgstr ":ref:`ทำซ้ำตาราง Pivot <spreadsheet/pivot-tables/duplicate>`"

#: ../../export/content/applications/productivity/spreadsheet/work_with_data/pivot_tables.rst:146
msgid ":ref:`Delete a pivot table <spreadsheet/pivot-tables/delete>`"
msgstr ":ref:`ลบตารางสรุปข้อมูล <spreadsheet/pivot-tables/delete>`"

