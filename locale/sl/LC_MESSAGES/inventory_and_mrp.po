msgstr ""
":ref:`Prikaži predvideno količino <inventory/product_management/on-hand>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:150
msgid ""
":ref:`Use reordering rules <inventory/product_management/replenishment>`"
msgstr ""
":ref:`Uporabi pravila za ponovno naročanje <inventory/product_management/"
"replenishment>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:153
msgid ""
":ref:`Can be included in a purchase order <inventory/product_management/po>`"
msgstr ""
":ref:`Lahko je vključeno v nabavno naročilo <inventory/product_management/"
"po>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:156
msgid ":ref:`Use putaway rules <inventory/product_management/putaway>`"
msgstr ""
":ref:`Uporabi pravila za odlaganje <inventory/product_management/putaway>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:159
msgid ""
":ref:`Can be manufactured, subcontracted, or used in another good's BoM "
