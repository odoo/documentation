msgstr "Haz clic en el icono :icon:`fa-cog` :guilabel:`(engranaje)`."

#: ../../export/content/applications/finance/fiscal_localizations/malaysia.rst:480
msgid "Select :guilabel:`Download`"
msgstr "Selecciona :guilabel:`Descargar`."

#: ../../export/content/applications/finance/fiscal_localizations/malaysia.rst:481
msgid "Choose either :guilabel:`PDF` or :guilabel:`PDF without Payment`"
msgstr "Selecciona ya sea :guilabel:`PDF` o :guilabel:`PDF sin pago`."

#: ../../export/content/applications/finance/fiscal_localizations/malaysia.rst:483
msgid "MyInvois QR code"
msgstr "Código QR de MyInvois"

