#: ../../content/applications/productivity/knowledge.rst:105
msgid ":guilabel:`Item Cards`"
msgstr ":guilabel:`Карти на елементи`"

#: ../../content/applications/productivity/knowledge.rst:106
msgid ""
"Insert a Card view and create :ref:`article items "
"<knowledge/articles_editing/items>`."
msgstr ""
"Вмъква изглед с карти и създава :ref:`елементи на статия <knowledge/"
"articles_editing/items>`."

#: ../../content/applications/productivity/knowledge.rst:107
msgid ":guilabel:`Item List`"
msgstr ":guilabel:`Списък на елементи`"

#: ../../content/applications/productivity/knowledge.rst:108
msgid ""
"Insert a List view and create :ref:`article items "
"<knowledge/articles_editing/items>`."
msgstr ""
"Вмъква списъчен изглед и създава :ref:`елементи на статия <knowledge/"
"articles_editing/items>`."

#: ../../content/applications/productivity/knowledge.rst:109
msgid ":guilabel:`Item Calendar`"
msgstr ":guilabel:`Календар на елементи`"

#: ../../content/applications/productivity/knowledge.rst:110
msgid ""
"Insert a Calendar view and create :ref:`article items "
