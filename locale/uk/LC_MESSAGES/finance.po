msgstr "**Для ПДВ (податку на додану вартість)**:"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:0
msgid ""
"`IVA [percent] (104, [form code] [tax support code] [tax support short "
"name])`"
msgstr ""
"`IVA [відсоток] (104, [код форми] [код податкової підтримки] [коротка назва "
"податкової підтримки])`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:0
msgid "Example: `IVA 12% (104, RUC [tax support code] IVA)`"
msgstr "Приклад: `IVA 12% (104, RUC [код податкової підтримки] IVA)`"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:0
msgid "**For Income Tax Withholding codes**:"
msgstr "**Для кодів утримання податку на прибуток**:"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:0
