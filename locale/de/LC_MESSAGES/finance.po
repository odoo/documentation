msgstr "Vollständiger Vergleich"

#: ../../content/applications/finance/fiscal_localizations/france.rst:620
msgid "3-digits comparison"
msgstr "3-Ziffern-Vergleich"

#: ../../content/applications/finance/fiscal_localizations/france.rst:620
