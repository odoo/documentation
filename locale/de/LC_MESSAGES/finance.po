msgstr "*Zuordnungsregel für Emissionsfaktor #1*"

#: ../../content/applications/finance/esg.rst:227
#: ../../content/applications/finance/esg.rst:239
#: ../../content/applications/finance/esg.rst:258
#: ../../content/applications/finance/esg.rst:270
msgid "*Any Account*"
msgstr "*Beliebiges Konto*"

#: ../../content/applications/finance/esg.rst:228
#: ../../content/applications/finance/esg.rst:259
msgid "*Any Partner*"
msgstr "*Beliebiger Partner*"

#: ../../content/applications/finance/esg.rst:229
#: ../../content/applications/finance/esg.rst:260
#: ../../content/applications/finance/esg.rst:272
msgid "**Zenith Pro Computer**"
msgstr "**Zenith Pro Computer**"

#: ../../content/applications/finance/esg.rst:231
#: ../../content/applications/finance/esg.rst:262
