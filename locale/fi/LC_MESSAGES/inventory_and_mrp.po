"lomakkeella."

#: ../../export/content/applications/inventory_and_mrp/inventory/shipping_receiving/removal_strategies/fefo.rst:142
msgid ""
"Show expiration dates from the Lots/Serial Numbers list on the product form."
msgstr ""
