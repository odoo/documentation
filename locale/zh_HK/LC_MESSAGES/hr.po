msgstr "`l10n_ae_hr_payroll`"

#: ../../export/content/applications/hr/payroll/payroll_localizations/united_arab_emirates.rst:25
msgid "Includes all rules, calculations, and salary structures."
msgstr "包括所有規則、計算方式及薪酬結構。"

#: ../../export/content/applications/hr/payroll/payroll_localizations/united_arab_emirates.rst:26
msgid ":guilabel:`United Arab Emirates - Payroll with Accounting`"
msgstr ":guilabel:`阿拉伯聯合酋長國 - 含會計的薪酬`"

#: ../../export/content/applications/hr/payroll/payroll_localizations/united_arab_emirates.rst:27
msgid "`l10n_ae_hr_payroll_account`"
msgstr "`l10n_ae_hr_payroll_account`"

#: ../../export/content/applications/hr/payroll/payroll_localizations/united_arab_emirates.rst:28
msgid "Includes all accounts related to the payroll module."
msgstr "包括與薪酬模組相關的所有會計科目。"

#: ../../export/content/applications/hr/payroll/payroll_localizations/united_arab_emirates.rst:31
msgid ""
":doc:`United Arab Emirates fiscal localization documentation "
"<../../../finance/fiscal_localizations/united_arab_emirates>`"
