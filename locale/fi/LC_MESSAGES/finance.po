msgid "Then, all Payments must be grouped in a **Batch Payment**."
msgstr "Kaikki maksut on sitten ryhmiteltävä **eräsuoritukseen**."

#: ../../export/content/applications/finance/fiscal_localizations/italy.rst:828
msgid ":doc:`Batch Payments <../accounting/payments>`"
msgstr ":doc:`Eräsuoritukset <../accounting/payments>`"

#: ../../export/content/applications/finance/fiscal_localizations/italy.rst:829
msgid ":doc:`Create a Batch Payment <../accounting/payments/batch>`"
msgstr ":doc:`Eräsuorituksen luominen <../accounting/payments/batch>`"

#: ../../export/content/applications/finance/fiscal_localizations/italy.rst:831
msgid ""
"Once you press the :guilabel:`Validate` button for the Batch Payment, the |"
"Ri.Ba.| file is generated and attached to the Batch Payment, so you can "
"download it and upload it through your bank's web portal."
msgstr ""
