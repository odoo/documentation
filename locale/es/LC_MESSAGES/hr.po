#: ../../export/content/applications/hr/payroll/payroll_localizations/mexico.rst:56
msgid "Adds CFDI XML and PDF files as an attachment on payslip emails."
msgstr ""
"Adjunta los archivos XML y PDF del CFDI a los correos electrónicos de las "
