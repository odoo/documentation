msgstr "Відпустка за сімейними обставинами (родичі 1-го ступеня)"

#: ../../export/content/applications/hr/payroll/payroll_localizations/oman.rst:232
msgid "2nd-degree relatives' compassionate leave"
msgstr "Відпустка за сімейними обставинами (родичі 2-го ступеня)"

#: ../../export/content/applications/hr/payroll/payroll_localizations/oman.rst:234
