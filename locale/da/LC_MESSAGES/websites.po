msgid ":ref:`Create a Shift <planning/create-shift>`"
msgstr ":ref:`Opret en vagt <planning/create-shift>`"

#: ../../export/content/applications/websites/website/web_design/building_blocks/forms.rst:26
msgid ""
":doc:`Create a Task </applications/services/project/tasks/task_creation>`"
msgstr ""
":doc:`Opret en opgave </applications/services/project/tasks/task_creation>`"

