msgid ""
":ref:`Example 2: 100% down payment <sales/down_payment/100-percent-down-"
"payments>`"
msgstr ""
":ref:`Voorbeeld 2: Aanbetaling van 100% <sales/down_payment/100-percent-down-"
"payments>`"

