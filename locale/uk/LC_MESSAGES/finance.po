msgid "eCommerce"
msgstr "Електронна комерція"

#: ../../content/applications/finance/fiscal_localizations/ecuador.rst:785
msgid ""
"The :ref:`ATS Report module <localizations/ecuador/ats>` enables the "
"following:"
