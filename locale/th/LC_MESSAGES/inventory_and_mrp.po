msgid ""
"Create and :ref:`confirm a PO <inventory/reception-report/workflow/confirm-"
"po>` for the demanded products."
msgstr ""

#: ../../content/applications/inventory_and_mrp/inventory/warehouses_storage/inventory_management/reception_report.rst:44
msgid ""
"Open receipt and :ref:`access the reception report <inventory/reception-"
"report/workflow/reception-report>` to allocate products."
msgstr ""

