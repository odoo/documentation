#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:2426
msgid "Assistance in completing the Social Balance Sheet"
msgstr "Hilfe beim Ausfüllen der Sozialbilanz"

#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:2428
