#: ../../export/content/applications/finance/accounting/bank/bank_synchronization.rst:157
msgid "Missing transactions"
msgstr ""

#: ../../export/content/applications/finance/accounting/bank/bank_synchronization.rst:159
msgid ""
"Missing or pending transactions are entries that the bank has not yet "
"validated."
msgstr ""

