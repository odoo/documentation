msgid ""
"A delivery order must be in the :guilabel:`Done` state (i.e., validated)"
msgstr "הזמנת משלוח חייבת להיות במצב :guilabel:`בוצע` (כלומר, מאושרת)"

#: ../../export/content/applications/finance/fiscal_localizations/india.rst:420
msgid "A receipt must have the :guilabel:`Ready` or :guilabel:`Done` state."
msgstr "קבלה חייבת להיות במצב :guilabel:`מוכן` או :guilabel:`בוצע`."

#: ../../export/content/applications/finance/fiscal_localizations/india.rst:422
msgid ""
"Click :guilabel:`Generate e-Waybill` to validate the E-Way bill and send it "
