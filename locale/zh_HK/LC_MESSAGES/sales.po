#: ../../export/content/applications/sales/sales/products_prices/prices/pricing.rst:250
msgid "Daily rates and members"
msgstr "每日費率及成員"

#: ../../export/content/applications/sales/sales/products_prices/prices/pricing.rst:252
msgid ""
"At the top of the *Pricelists* page, there are two smart buttons: "
