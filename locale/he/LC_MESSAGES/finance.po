#: ../../export/content/applications/finance/fiscal_localizations/india.rst:391
msgid "Cancel reason and remarks"
msgstr "סיבת ביטול והערות"

#: ../../export/content/applications/finance/fiscal_localizations/india.rst:395
msgid ""
"Once you request to cancel the E-Way bill, Odoo automatically submits the "
