msgstr ":doc:`Khai thác lead <../sales/crm/acquire_leads/lead_mining>`"

#: ../../export/content/applications/essentials/in_app_purchase.rst:88
msgid ""
":doc:`Enrich your contacts base with Partner Autocomplete <../sales/crm/"
