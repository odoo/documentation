#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/replenishment/lead_times.rst:287
msgid ":guilabel:`Vendor Lead Time`: 1 day"
msgstr ":guilabel:`Срок за изпълнение от доставчика`: 1 ден"

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/replenishment/lead_times.rst:288
msgid ":guilabel:`Days to Purchase`: 2 days"
msgstr ":guilabel:`Дни за покупка`: 2 дни"

#: ../../export/content/applications/inventory_and_mrp/inventory/warehouses_storage/replenishment/lead_times.rst:290
