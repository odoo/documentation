#: ../../content/applications/websites/website/configuration/spam_protection.rst:105
msgid "On Odoo"
msgstr "Odoossa"

#: ../../content/applications/websites/website/configuration/spam_protection.rst:66
msgid ""
"From the database dashboard, open the **Settings** app. "
