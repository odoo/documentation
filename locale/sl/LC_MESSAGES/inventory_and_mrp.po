msgstr ""
":ref:`Lahko je proizvedeno, poddano ali uporabljeno v kosovnici drugega "
"blaga <inventory/product_management/manufacturing>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:163
msgid ""
":doc:`Use inventory adjustments <../../warehouses_storage/"
"inventory_management/count_products>`"
msgstr ""
":doc:`Uporabi prilagoditve zaloge <../../warehouses_storage/"
"inventory_management/count_products>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:167
msgid ":doc:`Use inventory valuation <../../inventory_valuation/cheat_sheet>`"
msgstr ""
":doc:`Uporabite vrednotenje zalog <../../inventory_valuation/cheat_sheet>`"

#: ../../export/content/applications/inventory_and_mrp/inventory/product_management/configure/type.rst:170
