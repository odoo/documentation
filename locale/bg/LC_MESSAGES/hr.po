msgid ":doc:`recruitment/new_job`"
msgstr ""

#: ../../content/applications/hr/recruitment.rst:365
msgid ":doc:`recruitment/post_job`"
msgstr ""

#: ../../content/applications/hr/recruitment.rst:366
