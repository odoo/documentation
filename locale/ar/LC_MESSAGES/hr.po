msgstr "شهادة إجازات المغادرة N-1."

#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:394
msgid "Departure Holiday Attests Payslip N-1."
msgstr "قسيمة راتب شهادات إجازات المغادرة N-1."

#: ../../export/content/applications/hr/payroll/payroll_localizations/belgium.rst:397
msgid ""
"For year N, you can also see the number off additional time off (European) "
